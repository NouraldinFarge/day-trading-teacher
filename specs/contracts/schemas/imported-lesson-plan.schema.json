{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:day-trading-teacher:lesson-plan:1.0",
  "title": "ImportedLessonPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "version", "title", "origin", "target_skill_ids", "prerequisites", "lessons", "sources", "created_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "plan_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 40 },
    "title": { "type": "string", "minLength": 3, "maxLength": 160 },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "provider"],
      "properties": {
        "type": { "enum": ["external_generated", "user_authored"] },
        "provider": { "type": "string", "minLength": 1, "maxLength": 80 },
        "model": { "type": "string", "maxLength": 80 }
      }
    },
    "target_skill_ids": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string" } },
    "prerequisites": { "type": "array", "maxItems": 20, "items": { "type": "string" } },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/lesson" }
    },
    "sources": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 240 },
          "url": { "type": "string", "format": "uri" },
          "last_verified": { "type": "string", "format": "date" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lesson_id", "version", "title", "skill_ids", "objective", "estimated_minutes", "sections", "mastery_criteria"],
      "properties": {
        "lesson_id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{2,79}$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 },
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "skill_ids": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string" } },
        "objective": { "type": "string", "minLength": 10, "maxLength": 1000 },
        "estimated_minutes": { "type": "integer", "minimum": 1, "maximum": 90 },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "title", "body"],
            "properties": {
              "type": { "enum": ["retrieval", "explanation", "worked_example", "practice", "transfer", "commitment"] },
              "title": { "type": "string", "minLength": 1, "maxLength": 120 },
              "body": { "type": "string", "minLength": 1, "maxLength": 8000 },
              "prompt": { "type": "string", "maxLength": 4000 },
              "answer": { "type": "string", "maxLength": 4000 },
              "check": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "options", "correctOption", "success", "correction"],
                "properties": {
                  "kind": { "const": "single_choice" },
                  "options": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 6,
                    "items": { "type": "string", "minLength": 1, "maxLength": 500 }
                  },
                  "correctOption": { "type": "integer", "minimum": 0 },
                  "success": { "type": "string", "minLength": 1, "maxLength": 1000 },
                  "correction": { "type": "string", "minLength": 1, "maxLength": 1000 }
                }
              }
            }
          }
        },
        "mastery_criteria": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "type": "string", "minLength": 3, "maxLength": 500 } },
        "calculation_examples": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entry", "stop", "maximum_risk", "slippage_per_unit", "side", "expected_quantity"],
            "properties": {
              "entry": { "type": "string" },
              "stop": { "type": "string" },
              "maximum_risk": { "type": "string" },
              "slippage_per_unit": { "type": "string" },
              "side": { "enum": ["long", "short"] },
              "expected_quantity": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
